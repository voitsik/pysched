schedarch = get_option('schedarch')

if schedarch in ['linux', 'unix', 'sun', 'hp']
  extension_sources += [
    'src/Cit/sys_unix/envir.f',
    'src/Cit/sys_unix/krdlin.f',
    'src/Cit/sys_unix/prognm.f',
    'src/Cit/sys_unix/putout.f',
    'src/Cit/sys_unix/schdefs.f',
    'src/Cit/sys_unix/symsub.f',
    'src/Cit/sys_unix/tsttty.f',
    'src/Cit/sys_unix/vmshlp.f',
  ]
endif

if schedarch == 'linux'
  extension_sources += [
    'src/Cit/sys_linux/error.f',
    'src/Cit/sys_linux/gerror.c',
    'src/Cit/sys_linux/idate.c',
    'src/Cit/sys_linux/isatty.c',
    'src/Cit/sys_linux/vlbope.f',
  ]
else
  if schedarch in ['sun', 'hp']
    extension_sources += [
      'src/Cit/sys_sun/error.f',
      'src/Cit/sys_sun/vlbope.f',
    ]
  endif
endif

f2py_input_sources = extension_sources
f2py_include_dirs = [
  join_paths(meson.current_source_dir(), 'src/Cit'),
  join_paths(meson.current_source_dir(), 'src/Plot'),
  join_paths(meson.current_source_dir(), 'src/Sat'),
  join_paths(meson.current_source_dir(), 'src/Sched'),
  join_paths(meson.current_source_dir(), 'src/Sched/Freq/VLBA'),
  join_paths(meson.current_source_dir(), 'src/Vex'),
  join_paths(meson.current_source_dir(), 'src/Vex2'),
]

f2py_command = [
  py,
  '-m', 'numpy.f2py',
  '--lower',
  '--include-paths', ':'.join(f2py_include_dirs),
  '-m', 'schedlib',
  '@INPUT@',
  'only:',
] + f2py_functions + [':', '--build-dir', '@OUTDIR@']

f2py_module = custom_target(
  'schedlib-f2py-wrapper',
  input: f2py_input_sources,
  output: ['schedlibmodule.c', 'schedlib-f2pywrappers.f'],
  command: f2py_command,
  depend_files: f2py_includes,
)

numpy_include = run_command(
  py, '-c', 'import numpy; print(numpy.get_include())', check: true,
).stdout().strip()
f2py_include = run_command(
  py, '-c', 'import numpy.f2py; print(numpy.f2py.get_include())', check: true,
).stdout().strip()
numpy_dependency = declare_dependency(
  compile_args: ['-I' + numpy_include, '-I' + f2py_include],
)
fortranobject_source = join_paths(f2py_include, 'fortranobject.c')

py.extension_module(
  'schedlib',
  [f2py_module[0], f2py_module[1], fortranobject_source] + extension_sources,
  dependencies: numpy_dependency,
  include_directories: include_directories(
    'src/Cit',
    'src/Plot',
    'src/Sat',
    'src/Sched',
    'src/Sched/Freq/VLBA',
    'src/Vex',
    'src/Vex2',
  ),
  install: true,
)

list_package_files = '''
from pathlib import Path
import sys
root = Path(sys.argv[1])
package = root / sys.argv[2]
print(chr(10).join(str(path.relative_to(root)) for path in sorted(package.glob('*.py'))))
'''
foreach package_dir : ['src/pysched', 'src/pysched/catalog', 'src/pysched/sched']
  package_files = run_command(
    py, '-c', list_package_files, meson.current_source_dir(), package_dir,
    check: true,
  ).stdout().strip().split('\n')
  install_subdir = package_dir.replace('src/', '')
  py.install_sources(package_files, subdir: install_subdir)
endforeach

list_data_files = '''
from pathlib import Path
import sys
root = Path(sys.argv[1])
paths = sorted(path for folder in ('catalogs', 'setups')
               for path in (root / folder).rglob('*') if path.is_file())
print(chr(10).join(str(path.relative_to(root)) for path in paths))
'''
data_files = run_command(
  py, '-c', list_data_files, meson.current_source_dir(), check: true,
).stdout().strip().split('\n')

# Keep data alongside the installed Python package; get_catalog_dir() resolves
# these paths relative to the pysched package.
install_data(
  data_files,
  install_dir: py.get_install_dir(),
  preserve_path: true,
)
install_data(
  'src/sched.py',
  install_dir: get_option('bindir'),
  install_mode: 'rwxr-xr-x',
)
